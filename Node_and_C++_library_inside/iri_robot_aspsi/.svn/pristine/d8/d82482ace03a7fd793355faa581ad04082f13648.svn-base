    <arg name="y"     value="-7.5"/>
    <arg name="yaw"   value="1.57"/>
  </include>

<include file="$(find iri_objects_description)/launch/spawn_person.launch">
    <arg name="name" value="person5"/>
    <arg name="type" value="person"/>
    <arg name="x"     value="1.0"/>
