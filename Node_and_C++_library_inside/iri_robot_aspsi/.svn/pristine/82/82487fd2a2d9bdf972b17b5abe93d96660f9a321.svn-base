		std::cout << "(before initialice files) time_tot=robot_plan_companion3_start_ITER-robot_plan_companio3_end_ITER="<<((robot_plan_companion3_end_ITER-robot_plan_companion3_start_ITER)/CLOCKS_PER_SEC)<< std::endl;
