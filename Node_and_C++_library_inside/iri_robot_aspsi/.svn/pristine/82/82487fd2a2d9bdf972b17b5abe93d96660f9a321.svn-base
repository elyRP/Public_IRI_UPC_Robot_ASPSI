		std::cout << "(before switch(Action_)) time_tot=robot_plan_companion3_start_ITER-robot_plan_companion3_end_ITER="<<(robot_plan_companion3_end_ITER-robot_plan_companion3_start_ITER)/1000000<< std::endl;
	}
