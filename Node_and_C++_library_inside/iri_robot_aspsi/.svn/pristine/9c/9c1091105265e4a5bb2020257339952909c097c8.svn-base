			x =lambda_x*dest_1.x + (1-lambda_x)*dest_2.x + rand_normal(0,0.5);
			y = lambda_y*dest_1.y + (1-lambda_y)*dest_2.y + rand_normal(0,0.5);

		} while( read_force_map_success_ && !is_cell_clear_map( x, y ) );
