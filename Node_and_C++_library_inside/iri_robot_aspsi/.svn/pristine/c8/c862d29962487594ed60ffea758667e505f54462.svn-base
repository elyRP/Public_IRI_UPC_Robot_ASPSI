						}
					}
					// fin case side-by-side:
				/*}else{
					d = sqrt((iit->get_planning_trajectory( )->at(t).cov_dist(p,det)-person_radi_amp_)*(iit->get_planning_trajectory( )->at(t).cov_dist(p,det)-person_radi_amp_));
					if ( d < robot_person_companion_distance_ )
