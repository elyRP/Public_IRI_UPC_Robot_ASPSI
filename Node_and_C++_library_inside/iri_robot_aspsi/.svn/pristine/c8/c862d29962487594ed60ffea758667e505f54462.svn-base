		before_person_comp_goal_=final_person_obj->get_best_dest();


		if(use_before_theta){
			theta=last_good_theta_person_;
		}

			/*        	    double inc_angle=0;
			        	    double inc_angle1=0;
			        		double media_ponderada=0; //media ponderada que pesen más los angulos finales, para que vaya mejor en el giro.
