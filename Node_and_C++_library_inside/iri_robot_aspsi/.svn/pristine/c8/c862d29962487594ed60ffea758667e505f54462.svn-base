	fileMatlab << " \n \n \n % New iteration! \n";

	if(debug_file_evaluate_costs_){
		std::cout <<" \n \n \n % New iteration!  "<< std::endl;
	}

	fileMatlab << "\n  iter_act="<<iter<<";\n";

