			fileMatlab2.close();
		}
	}else if((ini_angle_act<0)&&(ini_angle_act>=(-180))){
		//ini_angle_act=180+ini_angle_act;
		ini_angle_act=sqrt(ini_angle_act*ini_angle_act);
		if(debug_cout_robot_){
