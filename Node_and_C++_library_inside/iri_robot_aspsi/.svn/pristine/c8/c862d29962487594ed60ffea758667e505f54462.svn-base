	Action_=Cplan_local_nav_person_companion::ITER;
    edge_.reserve((size_t)max_iter_);
    cost_int_forces_.reserve((size_t)max_iter_);
    cost_robot_.reserve((size_t)max_iter_);
    cost_obstacles_.reserve((size_t)max_iter_);
