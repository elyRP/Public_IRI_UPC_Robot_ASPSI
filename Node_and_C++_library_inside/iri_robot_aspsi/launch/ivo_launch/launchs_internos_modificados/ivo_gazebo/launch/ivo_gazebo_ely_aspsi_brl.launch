<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <arg name="world"  default="master_big"/>  <!-- empty, ... (see ../worlds) -->
  <arg name="laser_model"  default="sick-571"/>
  <arg name="multi" default=""/>
  <arg name="gzpose" default="-x 11.5 -y 19.0 -z 0.0 -R 0.0 -P 0.0 -Y 0.0"/>
  <arg name="gui" default="true"/>
  <arg name="debug" default="false"/>
  <arg name="public_sim" default="false"/>
  <arg name="tuck_arm" default="true"/>
  <arg name="recording" default="false"/>
  <arg name="extra_gazebo_args" default=""/>
  <arg name="use_moveit_camera" default="false"/>
 <arg name="rviz"     default="true"/>

  <env name="LC_NUMERIC" value="C" />

  <!-- start up world -->
  <!--   <include file="$(find pal_gazebo_worlds)/launch/pal_gazebo.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="recording" value="$(arg recording)"/>
    <arg name="extra_gz_model_path" value="$(find ivo_gazebo)/models"/>
    <arg name="extra_gz_resource_path" value="$(find ivo_gazebo)"/>
	    <arg name="extra_gazebo_args" value="$(arg extra_gazebo_args)"/>
	  </include>
-->

<arg name="gui" default="true"/>
    <arg name="world_name"      default="master_big"/>
    <arg name="world_description" default="true"/>
    <arg name="public_sim" default="false"/>


<include file="$(find iri_gazebo_worlds)/launch/test.launch">
    <arg name="gui"         value="$(arg gui)"/>
    <arg name="world_name"  value="$(arg world_name)"/> 
    <arg name="description" value="$(arg world_description)"/> 
    <arg name="rviz"        value="false"/> 
  </include>



  <!-- spawn robot in simulation -->
  <include file="$(find ivo_gazebo)/launch/ivo_spawn.launch">
    <arg name="laser_model"  value="$(arg laser_model)"/>
    <arg name="multi" value="$(arg multi)"/>
    <arg name="gzpose" value="$(arg gzpose)"/>
  </include>

  <!-- bring up robot -->
  <include file="$(find ivo_gazebo)/launch/simulation_ivo_bringup.launch">
    <arg name="laser_model" value="$(arg laser_model)"/>
    <arg name="public_sim"  value="$(arg public_sim)"/>
    <arg name="use_moveit_camera" value="$(arg use_moveit_camera)"/>
  </include>

  <!-- Robosense points to laserscan -->
  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan">
    <remap from="cloud_in" to="base_lidar_points"/>
    <remap from="scan"     to="scan"/>
    <rosparam file="$(find ivo_laser_sensors)/config/robosense_cloud_laser.yaml" command="load"/>
  </node>

  <group if="$(arg tuck_arm)">
      <node name="tuck_arm" pkg="ivo_gazebo" type="tuck_arm.py" output="screen"/>
  </group>


  <include file="$(find iri_objects_description)/launch/spawn_person.launch">
    <arg name="name" value="person1"/>
    <arg name="type" value="person"/>
    <arg name="x"     value="12.0"/> 
    <arg name="y"     value="20.5"/> 
    <arg name="yaw"   value="0.0"/> 
  </include>

 <include file="$(find iri_objects_description)/launch/spawn_person.launch">
    <arg name="name" value="person2"/>
    <arg name="type" value="person"/>
    <arg name="x"     value="12.0"/> 
    <arg name="y"     value="21.5"/> 
    <arg name="yaw"   value="0.0"/> 
  </include>


    <arg name="ns"                         default="robot"/>
  <arg name="map_frame_id"               default="map"/>
  <arg name="map_name"                 default="master_big"/>
  <arg name="map_topic"                  default="/map"/>
  <arg name="use_map_server"             default="true"/> 
 <arg name="output"                     default="screen" />
 <arg name="launch_prefix"              default="" />
  <arg name="use_map"                    default="true"/>
  <arg name="use_map_server"             default="true"/>
 <arg name="map_service"                default="/static_map"/>

  <group if="$(arg use_map)">
    <group if="$(arg use_map_server)">
      <include file="$(find iri_rosnav)/launch/include/map_server_tiago.launch">
        <arg name="ns"            value="$(arg ns)"/>
        <arg name="map_frame_id"  value="$(arg map_frame_id)"/>
        <arg name="map_name"      value="$(arg map_name)"/>
        <arg name="map_topic"     value="$(arg map_topic)"/>
        <arg name="map_service"   value="$(arg map_service)"/>
        <arg name="output"        value="$(arg output)" />
        <arg name="launch_prefix" value="$(arg launch_prefix)" />
      </include>
    </group>
</group>


 <node name="rviz" pkg="rviz" type="rviz" if="$(arg rviz)"
	 args="-d /home/user/ws_ivo/src/navigation/iri_robot_aspsi/rviz/ivo_rviz.rviz"/>

</launch>
