        final_goal_to_go: true
        goal_to_follow_path: true
        scene: true
        scene_goal: true
        scene_goal1: true
        scene_goal2: true
        scene_w: true
      Queue Size: 100
      Value: true
    - Alpha: 0.699999988079071
